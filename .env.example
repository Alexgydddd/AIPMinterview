# Text AI (required). Server-only: never use VITE_ for credentials.
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# Required for every production/preview deployment; share only with invited testers.
# Use a random value of at least 24 characters, never commit the real value.
BETA_ACCESS_CODE=

# Optional image OCR. Text PDFs are extracted locally in the browser.
SILICONFLOW_API_KEY=
SILICONFLOW_API_BASE=https://api.siliconflow.cn/v1
OCR_MODEL_ID=Qwen/Qwen2.5-VL-72B-Instruct

# Optional question narration. Text interviews work without this.
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_API_BASE=https://api.minimax.io
